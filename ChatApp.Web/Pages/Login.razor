@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<PageTitle>Sign in</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Sign in</h1>

        <div class="form-group">
            <label>Email</label>
            <input type="email" @bind="_email" placeholder="you@example.com" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="password" @bind="_password"
                    @onkeydown="OnKeyDown" 
                   placeholder="Your password" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error">@_error</p>
        }

        <button class="btn-primary" @onclick="LoginMethod" disabled="@_loading">
            @(_loading ? "Signing in..." : "Sign in")
        </button>

        <p class="auth-link">No account? <a href="/register">Create one</a></p>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _loading;

    private async Task LoginMethod()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Email and password are required.";
            return;
        }

        _loading = true;
        _error = null;

        try
        {
            var result = await AuthService.LoginAsync(new LoginRequest(_email, _password));

            if (result.Succeeded)
                Nav.NavigateTo("/", forceLoad: true); // force reload so auth state refreshes
            else
                _error = result.Errors.FirstOrDefault() ?? "Sign in failed.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoginMethod();
    }
}
