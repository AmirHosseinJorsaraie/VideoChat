@page "/login"

<PageTitle>Sign in</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Sign in</h1>

        <form method="post" action="/auth/login" onsubmit="return signInLoading(this)">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Your password" />
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <p class="error">@Error</p>
            }

            <button type="submit" class="btn-primary" id="loginButton">
                <span class="btn-content">
                    <span class="btn-text">Sign in</span>

                    <span class="loading-content d-none">
                        <span class="spinner"></span>
                        <span>Signing in...</span>
                    </span>
                </span>
            </button>
        </form>

        <p class="auth-link">No account? <a href="/register">Create one</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
