@page "/register"

<PageTitle>Create account</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Create account</h1>

        <form method="post" action="/auth/register" onsubmit="return submitLoading(this)">
            <div class="form-group">
                <label>Display name</label>
                <input name="displayName" placeholder="How you appear in chat" required />
            </div>

            <div class="form-group">
                <label>Username</label>
                <input name="username" placeholder="lowercase, no spaces" required />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@example.com" required />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Min 8 characters" required />
            </div>

            <div class="form-group">
                <label>I want to</label>
                <div class="role-selector">
                    <label class="role-option">
                        <input type="radio" name="role" value="Viewer" checked />
                        👁 Watch streams
                    </label>
                    <label class="role-option">
                        <input type="radio" name="role" value="Streamer" />
                        🎙 Stream & host rooms
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <p class="error">@Error</p>
            }

            <button type="submit" class="btn-primary">
                <span class="btn-text">Create account</span>
                <span class="loading-content d-none">
                    <span class="spinner"></span>
                    <span>Creating account...</span>
                </span>
            </button>
        </form>

        <p class="auth-link">Already have an account? <a href="/login">Sign in</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
